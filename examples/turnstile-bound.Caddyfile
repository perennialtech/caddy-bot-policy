{
	servers {
		listener_wrappers {
			ja4
			tls
		}
		packet_conn_wrappers {
			ja4
		}
	}
}

example.com {
	ja4
	bot_policy {
		whitelist 192.0.2.10 2001:db8:1::/48
		blacklist t13d1517h2_8daaf6152771_b6f405a00624
	}
	turnstile {
		site_key {env.TURNSTILE_SITE_KEY}
		secret_key {env.TURNSTILE_SECRET_KEY}
		bind_fingerprint
	}
	reverse_proxy localhost:8080
}
